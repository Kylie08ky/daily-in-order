# Development defaults to local emulators; no live project is included.
VITE_FIREBASE_EMULATORS=true
# Fill in your own Firebase web app configuration for cloud use.
# These VITE_ values are public client identifiers, not server credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional comma-separated exact production hostnames for custom domains.
VITE_LIVE_HOSTS=

# Optional cloud AI; disabled by default and always disabled for emulator projects.
# Keep Firebase on Spark (no Cloud Billing) for a no-cost trial.
# Enable Gemini Developer API + Firebase AI Logic, register a domain-restricted
# App Check reCAPTCHA Enterprise key. Never add a Gemini secret/API key here.
VITE_AI_ENABLED=false
VITE_AI_MODEL=gemini-3.5-flash-lite
VITE_APPCHECK_SITE_KEY=
